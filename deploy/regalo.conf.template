# ============================================================
# El regalo detrás de un dominio: flores.duckdns.org
# ============================================================
#
# El contenedor escucha en el 2999 y se publica en el 2999 del VPS
# (docker-compose.yml). Este fichero es el `server` de nginx que manda el
# dominio a ese puerto. Cambia el `server_name` de abajo por el tuyo y ya.
#
# Dónde va, según dónde corra tu nginx:
#
#   · nginx en el host      -> /etc/nginx/sites-available/regalo.conf
#                              ln -s ... /etc/nginx/sites-enabled/
#                              nginx -t && systemctl reload nginx
#
#   · nginx en contenedor   -> nginx/templates/regalo.conf.template
#     (el caso de UCB-DEPORTES-BACKEND, imagen nginx:1.27-alpine)
#                              cp deploy/regalo.conf.template \
#                                 ../UCB-DEPORTES-BACKEND/nginx/templates/
#                              docker compose restart nginx
#
# Con nginx en contenedor, `restart` y no `reload`: las plantillas se procesan
# con envsubst SÓLO al arrancar. Y por eso el dominio va escrito a mano y no
# como ${VARIABLE}: si la variable no existiera en el entorno del contenedor,
# envsubst la dejaría literal, nginx no arrancaría y se llevaría por delante el
# frontend y la API. Un ensayo en seco antes de tocar producción:
#
#   docker run --rm -v "$PWD/nginx/templates:/etc/nginx/templates:ro" \
#     -v "$PWD/nginx/certbot/conf:/etc/letsencrypt" nginx:1.27-alpine nginx -t
#
# NO lleva bloque 443 a propósito: para `curl dominio` sólo hace falta el 80, y
# un `ssl_certificate` apuntando a un fichero que no existe impide arrancar a
# nginx entero. Si quieres HTTPS además, mira el final del fichero.

server {
  listen 80;
  server_name flores.duckdns.org;          # <-- tu dominio aquí

  # nada de `return 301 https://...` aquí: curl no sigue redirecciones si no le
  # pasan -L, así que redirigir es servir una línea de texto en vez del regalo.
  # Como nginx elige por server_name antes que por default_server, este bloque
  # gana al comodín sin tocar los del frontend ni los de la API.

  # por si algún día quieres emitir certificado para este dominio
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    # ------------------------------------------------------------------
    # Elige UNA de las tres. Para saber cuál te toca:
    #
    #     docker ps --format '{{.Names}}' | grep -i nginx
    #
    # Si no imprime nada, tu nginx corre en el host: caso (A).
    # Si imprime un nombre, corre en un contenedor: (B) si puedes meterlo en la
    # misma red que el regalo, (C) si prefieres no tocarle nada.
    # ------------------------------------------------------------------

    # (A) nginx en el HOST. El contenedor publica el 2999, se le llega por ahí.
    proxy_pass http://127.0.0.1:2999;

    # (B) nginx en CONTENEDOR, compartiendo red con el regalo. Es la buena si
    # puedes: se hablan por nombre, no hace falta ni publicar el puerto (puedes
    # quitar el `ports:` del compose y dejar de asomar a Internet). Descomenta
    # el `networks:` del docker-compose.yml, pon ahí el nombre de la red de tu
    # nginx (`docker inspect -f '{{json .NetworkSettings.Networks}}' TU-NGINX`),
    # comenta la línea (A) y descomenta estas tres. El resolver de Docker vuelve
    # a resolver cada 30s, así que redesplegar el regalo no deja a nginx con una
    # IP vieja.
    #
    # resolver 127.0.0.11 valid=30s ipv6=off;
    # set $regalo_host regalo-flores;
    # proxy_pass http://$regalo_host:2999$request_uri;

    # (C) nginx en CONTENEDOR y sin tocarle la red: como el puerto está
    # publicado en el host, se le llega por la puerta de enlace de su propia
    # red. Saca la IP con:
    #
    #     docker network inspect LA-RED-DE-NGINX -f '{{(index .IPAM.Config 0).Gateway}}'
    #
    # (suele ser 172.17.0.1 en la red por defecto). Comenta la (A) y pon:
    #
    # proxy_pass http://172.17.0.1:2999;

    proxy_http_version 1.1;
    proxy_set_header Host $host;                 # la página HTML enseña el
    proxy_set_header X-Real-IP $remote_addr;     # comando curl con este nombre
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # la animación es un streaming: si nginx la acumula, llega toda de golpe al
    # final. El servidor ya manda X-Accel-Buffering: no, esto es por si acaso.
    proxy_buffering off;
    proxy_cache off;
    gzip off;

    # el bucle final del rótulo no termina nunca: lo corta el usuario con
    # Ctrl-C. Con los 60s de por defecto, el regalo se cortaría solo al minuto.
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }
}

# ------------------------------------------------------------------
# Para que baste con `curl flores.duckdns.org` hacen falta dos cosas más:
#
#   1. un registro A del dominio apuntando a la IP del VPS (con DuckDNS, poner
#      la IP una vez y listo: no cambia);
#   2. que el 80 esté abierto en el firewall:  ufw allow 80/tcp
#
# Sin dominio funciona igual con `curl IP-DEL-VPS:2999`, que es el puerto que
# publica el contenedor.
#
# ¿HTTPS también? En este orden, y sin saltarse el primer paso:
#
#   1. con nginx en contenedor, añade  ensure_cert "${REGALO_DOMAIN}"  a
#      nginx/init-certs.sh y  REGALO_DOMAIN: flores.duckdns.org  al environment
#      del servicio nginx, para que el self-signed temporal exista antes de que
#      nginx lo busque;
#   2. reinicia nginx y emite el certificado de verdad:
#      docker compose run --rm certbot certonly --webroot -w /var/www/certbot \
#        -d flores.duckdns.org
#   3. y entonces sí, copia aquí un bloque 443 con este mismo server_name y el
#      mismo `location /` de arriba.
#
# El bloque 80 se queda como está: sin redirección, que es lo que hace que
# `curl flores.duckdns.org` siga funcionando.
# ------------------------------------------------------------------
